<section id="matching-recipes" class="related-recipes-section" aria-labelledby="recipes-heading">
  <div class="d-flex justify-content-between section-heading"><div><h2 id="recipes-heading"><%= local_assigns[:heading] || "Recipes" %></h2></div></div>
  <% if recipes.empty? %><p><%= local_assigns[:empty_message] || "No recipes yet." %></p><% end %>
  <div class="auto-grid recipe-grid recipe-catalog-grid compact-recipe-grid"><%= render recipes %></div>
</section>
