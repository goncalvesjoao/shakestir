<%= form_with model: collection, class: "p-4 shadow-none library-form" do |form| %>
  <% if collection.errors.any? %><div class="p-3 mb-4 rounded library-errors" role="alert"><strong>Check your collection details</strong><ul class="mb-0 ps-4"><% collection.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section"><%= form.label :name, "Collection name", class: "fw-semibold mb-2" %><p id="collection-name-help">A mood, an occasion, or simply your favorites.</p><%= form.text_field :name, required: true, placeholder: "e.g. Friday night favorites", aria: { describedby: "collection-name-help" }, class: "m-0 rounded" %></div>
  <% if collection.system_key == "favorites" %><p>Your starred recipes stay in this private Favorites collection. You can rename it.</p><% else %>
  <fieldset class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section library-privacy"><legend class="fw-semibold mb-3">Who can see this collection?</legend>
    <label class="p-3 mb-2 fw-normal gap-2 d-flex align-items-center library-privacy-option"><%= form.radio_button :visibility, "private", class: "m-0 flex-shrink-0" %><span class="d-none d-md-flex library-privacy-icon"><%= render "icon", name: "private" %></span><span><strong class="d-block fw-semibold">Private</strong><small class="d-block mt-1 lh-base">Only you. Keep your discoveries to yourself.</small></span></label>
    <label class="p-3 mb-2 fw-normal gap-2 d-flex align-items-center library-privacy-option"><%= form.radio_button :visibility, "public", class: "m-0 flex-shrink-0" %><span class="d-none d-md-flex library-privacy-icon"><%= render "icon", name: "public" %></span><span><strong class="d-block fw-semibold">Public</strong><small class="d-block mt-1 lh-base">Anyone with the link can view this collection.</small></span></label>
  </fieldset>
  <% end %>
  <div class="pt-4 border-top gap-4 d-flex align-items-center flex-wrap library-form-actions"><%= form.submit collection.persisted? ? "Save changes" : "Create collection", class: "text-nowrap gap-2 d-inline-flex justify-content-center align-items-center m-0 library-action primary size-md w-auto", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", collection.persisted? ? collection_path(collection) : my_collections_path, class: "d-inline-flex align-items-center library-cancel" %></div>
<% end %>
