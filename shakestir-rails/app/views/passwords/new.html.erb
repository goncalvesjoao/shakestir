<% content_for :title, "Reset password · ShakeStir" %>
<section class="p-4 shadow-none card form-page auth-page" aria-labelledby="reset-title">
  <h1 class="mb-2" id="reset-title">Reset your password</h1>
  <p>Enter your account’s email address. We’ll send a link to choose a new password.</p>
  <%= form_with url: passwords_path, class: "d-grid gap-2 mt-4" do |form| %>
    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "w-100" %>
    <%= form.submit "Email reset instructions", data: { turbo_submits_with: "Sending…" }, class: "w-100" %>
  <% end %>
  <div class="d-grid gap-1 mt-4 pt-3 auth-links"><%= link_to "Back to sign in", new_session_path, class: "d-inline-flex align-items-center" %></div>
</section>
