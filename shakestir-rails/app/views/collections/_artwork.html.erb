<div class="gap-1 d-grid overflow-hidden library-artwork <%= "library-artwork-empty" if recipes.empty? %>" aria-hidden="true">
  <% if recipes.empty? %>
    <span class="d-grid library-artwork-symbol"><%= render "collections/icon", name: collection.name == "Favorites" ? "heart" : "collection" %></span>
  <% else %>
    <% 4.times do |index| %>
      <div class="overflow-hidden library-artwork-tile">
        <% if recipes[index]&.image&.attached? %>
          <%= image_tag recipe_image_path(recipes[index], size: :card), alt: "", loading: "lazy", width: 320, height: 320 %>
        <% else %><span>J.</span><% end %>
      </div>
    <% end %>
  <% end %>
</div>
