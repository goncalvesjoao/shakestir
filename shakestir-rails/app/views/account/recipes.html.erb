<% content_for :title, "My recipes · ShakeStir" %>
<div class="library-page personal-recipes-page">
  <header class="align-items-start align-items-md-center gap-3 gap-md-4 flex-column flex-md-row d-flex justify-content-between library-heading">
    <div><h1>My recipes</h1><p class="m-0 library-description">From first ideas to your signature drinks.</p></div>
    <%= link_to new_recipe_path, class: "text-nowrap gap-2 d-inline-flex justify-content-center m-0 align-items-center button library-action primary size-md" do %><%= render "collections/icon", name: "plus" %>New recipe<% end %>
  </header>
  <% if @recipe_counts.values.sum.zero? %>
    <section class="p-5 d-flex flex-column align-items-center text-center library-empty"><span class="d-grid mb-4 library-empty-symbol"><%= render "collections/icon", name: "edit" %></span><h2 class="fs-3 mb-2 lh-sm">Every great drink starts with an idea.</h2><p>Create your first recipe. Keep it private while you make it yours.</p><%= link_to "Create your first recipe", new_recipe_path, class: "text-nowrap gap-2 d-inline-flex justify-content-center m-0 align-items-center button library-action primary size-md" %></section>
  <% else %>
    <div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3 gap-md-4 personal-toolbar">
      <nav class="gap-1 p-1 d-flex flex-wrap personal-filters" aria-label="Recipe status">
        <% [[nil, "All recipes", @recipe_counts.values.sum], ["draft", "Drafts", @recipe_counts.fetch("draft", 0)], ["published", "Published", @recipe_counts.fetch("published", 0)]].each do |state, label, count| %>
          <%= link_to my_recipes_path(state: state, q: params[:q].presence), class: "d-inline-flex align-items-center justify-content-center p-2 rounded text-decoration-none #{@publication_state == state ? "fw-medium" : "fw-semibold"}", aria: { current: ("page" if @publication_state == state) } do %><%= label %><span class="text-center fw-normal"><%= count %></span><% end %>
        <% end %>
      </nav>
      <%= form_with url: my_recipes_path, method: :get, class: "gap-2 d-flex align-items-center m-0 personal-search", role: "search" do |form| %>
        <%= form.hidden_field :state, value: @publication_state if @publication_state %>
        <%= form.label :q, "Search your recipes", class: "visually-hidden", for: "personal-recipe-search" %>
        <%= form.search_field :q, value: params[:q], placeholder: "Search your recipes", id: "personal-recipe-search", class: "m-0" %>
        <%= form.button "Search", type: :submit, class: "m-0 secondary" %>
      <% end %>
    </div>
    <div class="mb-4 gap-2 d-flex align-items-baseline justify-content-between flex-wrap library-section-label"><h2 class="m-0 fs-5"><%= params[:q].present? ? "Search results" : (@publication_state == "draft" ? "Your drafts" : (@publication_state == "published" ? "Published recipes" : "All recipes")) %></h2><span><%= pluralize(@recipes.size, "recipe") %> · Recently edited first</span></div>
    <% if @recipes.empty? %>
      <section class="p-5 d-flex flex-column align-items-center text-center library-empty"><h2 class="fs-3 mb-2 lh-sm">No recipes here yet.</h2><p><%= params[:q].present? ? "Try another name or clear your search to see more recipes." : (@publication_state == "draft" ? "Start a new recipe and save your next idea." : "Your published recipes will appear here.") %></p><%= link_to "View all recipes", my_recipes_path, class: "m-0 text-nowrap gap-2 d-inline-flex justify-content-center align-items-center button library-action secondary size-md" %></section>
    <% else %>
      <div id="recipes" class="auto-grid recipe-grid personal-recipe-grid">
        <% @recipes.each do |recipe| %>
          <%= render "recipes/personal_card", recipe: recipe %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
