<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">

    <title><%= "#{content_for(:title)} · ShakeStir" || "ShakeStir" %></title>

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ShakeStir">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "semanticus", "theme", "styles", "data-turbo-track": "reload", integrity: true %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content" class="visually-hidden-focusable">Skip to content</a>

    <header class="site-header content-grid py-3 m-0 border-bottom">
      <nav class="flex-wrap" aria-label="Main navigation">
        <%= link_to root_path, class: "brand-link order-0" do %>
          <%= render "shared/wordmark" %>
        <% end %>

        <ul class="primary-navigation order-2 order-md-1">
          <li><%= link_to "Explore", root_path, class: "p-2", aria: { current: ("page" if controller_name == "recipes" && %w[index show].include?(action_name)) } %></li>
          <li><%= link_to "Cocktails", cocktails_path, class: "p-2", aria: { current: ("page" if controller_name == "cocktails") } %></li>
          <li><%= link_to "Ingredients", ingredients_path, class: "p-2", aria: { current: ("page" if controller_name == "ingredients") } %></li>
          <li><%= link_to "Tools", utensils_path, class: "p-2", aria: { current: ("page" if controller_name == "utensils") } %></li>
          <li><%= link_to "Methods", techniques_path, class: "p-2", aria: { current: ("page" if controller_name == "techniques") } %></li>
        </ul>

        <ul class="gap-2 gap-lg-4 order-1 order-md-2">
          <% if authenticated? %>
            <li>
              <details>
                <summary aria-haspopup="menu" class="bg-transparent border-0">
                  <%= profile_avatar(current_user, size: 40, css_class: "rounded-circle object-fit-cover") %>
                </summary>

                <ul dir="rtl" role="menu">
                  <li><%= link_to "My recipes", user_recipes_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "My collections", user_collections_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "My profile", user_profile_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "My account", user_account_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "Log out", session_path, data: { turbo_method: :delete }, role: "menuitem" %></li>
                </ul>
              </details>
            </li>
          <% else %>
            <li><%= link_to "Log in", new_session_path, class: "d-inline-flex align-items-center button secondary" %></li>
            <li><%= link_to "Create account", new_registration_path, class: "d-inline-flex align-items-center button" %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <%= yield %>
    </main>

    <footer class="content-grid mt-3 mt-md-5 border-top py-4">
      <nav class="fs-small">
        <div>
          <%= link_to root_path, class: "brand-link" do %>
            <%= render "shared/wordmark" %>
          <% end %>

          <p class="mt-2 mb-1">Find a drink. Make it yours.</p>

          <small>&copy; <%= Date.current.year %> ShakeStir</small>
        </div>

        <ul class="gap-5" aria-label="Policies and help">
          <li>
            <p class="fs-6 fw-semibold mb-3">Policies</p>

            <ul class="d-flex flex-column gap-3 align-items-start">
              <li><%= link_to "Terms of service", terms_path %></li>
              <li><%= link_to "Privacy policy", privacy_path %></li>
              <li><%= link_to "Cookie policy", cookies_policy_path %></li>
            </ul>
          </li>

          <li>
            <p class="fs-6 fw-semibold mb-3">Using ShakeStir</p>

            <ul class="d-flex flex-column gap-3 align-items-start">
              <li><%= link_to "Community guidelines", community_guidelines_path %></li>
              <li><%= link_to "Responsible drinking", responsible_drinking_path %></li>
              <li><%= link_to "Help & contact", help_path %></li>
            </ul>
          </li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
