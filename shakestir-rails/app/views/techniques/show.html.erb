<% content_for :title, "#{@technique.display_name} · Techniques" %>

<article id="<%= dom_id @technique %>" class="content-grid" data-module="technique-details">
  <header class="hero full-width">
    <div class="row g-0 g-md-5 align-items-end">
      <div class="col-12 col-md-1 col-lg-2"></div>

      <hgroup class="col-12 col-md-10 col-lg-8 order-1 order-md-2 mb-0 mt-3">
        <h1><%= @technique.display_name.presence || "Untitled technique" %></h1>
        <p><%= @technique.description.presence || "No description available." %></p>
      </hgroup>
    </div>
  </header>

  <div class="row g-0 g-md-5 mt-5">
    <div class="col-12 col-md-1 col-lg-2"></div>

    <section class="col-12 col-md-10 col-lg-8">
      <h2>How to use it</h2>
      <%= simple_format @technique.instructions %>
      
      <% if @technique.tip.present? %>
        <hr class="my-4">

        <section>
          <h3 class="fs-5 text-muted">Beginner tip</h3>
          <%= simple_format @technique.tip, class: "text-muted" %>
        </section>
      <% end %>
    </section>
  </div>
</article>
