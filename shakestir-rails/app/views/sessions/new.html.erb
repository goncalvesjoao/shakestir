<% content_for :title, "Sign in · ShakeStir" %>
<section class="p-4 shadow-none card form-page auth-page" aria-labelledby="sign-in-title">
  <h1 class="mb-2" id="sign-in-title">Welcome back</h1>
  <p>Sign in to save drinks, organize collections, and work on your recipes.</p>
  <%= form_with url: session_path, class: "d-grid gap-2 mt-4" do |form| %>
    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "w-100" %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "w-100" %>
    <%= form.submit "Sign in", data: { turbo_submits_with: "Signing in…" }, class: "w-100" %>
  <% end %>
  <div class="d-grid gap-1 mt-4 pt-3 auth-links"><%= link_to "Forgot password?", new_password_path, class: "d-inline-flex align-items-center" %><%= link_to "Create an account", new_registration_path, class: "d-inline-flex align-items-center" %></div>
</section>
