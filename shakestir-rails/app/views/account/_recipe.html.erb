          <div class="position-relative personal-recipe">
            <%= render "recipes/recipe", recipe: recipe, personal: true %>
            <div class="pe-none d-flex gap-2 position-absolute justify-content-between align-items-center personal-recipe-status"><span class="fw-semibold py-1 px-2 d-inline-flex align-items-center gap-1 personal-state <%= "is-draft" if recipe.publication_state == "draft" %>"><%= recipe.publication_state.capitalize %></span><span class="fw-semibold py-1 px-2 d-inline-flex align-items-center gap-1 personal-visibility"><%= render "collections/icon", name: recipe.visibility %><%= recipe.visibility.capitalize %></span></div>
            <div class="border-top pt-2 gap-2 d-flex justify-content-between align-items-center flex-wrap personal-recipe-actions"><span>Edited <%= time_ago_in_words(recipe.updated_at) %> ago</span><% if policy(recipe).edit? %><%= link_to edit_recipe_path(recipe), class: "d-inline-flex align-items-center gap-2 fw-semibold", aria: { label: "Edit #{recipe.display_name.presence || "untitled recipe"}" } do %><%= render "collections/icon", name: "edit" %><%= recipe.publication_state == "draft" ? "Continue editing" : "Edit recipe" %><% end %><% end %></div>
          </div>
