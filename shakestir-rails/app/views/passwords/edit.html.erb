<% content_for :title, "Update password · ShakeStir" %>
<section class="p-4 shadow-none card form-page auth-page" aria-labelledby="password-title">
  <h1 class="mb-2" id="password-title">Choose a new password</h1>
  <p>Enter your new password twice to confirm it.</p>
  <%= form_with url: password_path(params[:token]), method: :put, class: "d-grid gap-2 mt-4" do |form| %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "w-100" %>
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "w-100" %>
    <%= form.submit "Update password", data: { turbo_submits_with: "Updating…" }, class: "w-100" %>
  <% end %>
  <div class="d-grid gap-1 mt-4 pt-3 auth-links"><%= link_to "Back to sign in", new_session_path, class: "d-inline-flex align-items-center" %></div>
</section>
