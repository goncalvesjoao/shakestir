<% content_for :title, "#{@owned ? "My" : @user.profile_name} profile" %>

<div class="content-grid">
  <article>
    <header class="row g-4 align-items-start align-items-md-center my-4">
      <div class="col-12 col-md-2 overflow-hidden">
        <%= profile_avatar(@user, image_class: "w-100 h-100 object-fit-cover rounded-circle") %>
      </div>

      <div class="col-12 col-md-10">
        <hgroup>
          <h1 class="mb-2">
            <%= @user.profile_name %>

            <% if @owned %>
              <%= link_to edit_user_profile_path(@user), class: "fw-normal d-inline-flex align-items-center gap-2 button secondary" do %>
                <%= render "collections/icon", name: "edit" %>Edit profile
              <% end %>
            <% end %>
          </h1>

          <p><%= @user.bio %></p>
        </hgroup>

        <div class="mt-3">
          <span>@<%= @user.handle %></span>
          <span class="ms-3">Joined <%= @user.created_at.strftime("%B %Y") %></span>
        </div>
      </div>
    </header>

    <section id="profile-collections" class="mb-5" aria-labelledby="profile-collections-title">
      <nav class="mb-3">
        <h2 class="fs-5" id="profile-collections-title">Public collections</h2>

        <% if @owned %>
          <%= link_to new_collection_path, class: "fw-semibold gap-2 d-inline-flex align-items-center profile-section-action" do %>
            <%= render "collections/icon", name: "plus" %>Create collection<% end %>
        <% end %>
      </nav>

      <% if @collections.empty? %>
        <div class="card p-4 d-flex gap-3 align-items-center">
          <%= render "collections/icon", name: "collection" %>

          <hgroup>
            <h3 class="fs-5"><%= @owned ? "Keep your favorites together." : "No public collections yet." %></h3>
            <p><%= @owned ? "Create a collection for an occasion, a mood, or a drink you love." : "This member hasn’t shared a collection yet." %></p>
          </hgroup>
        </div>
      <% else %>
        <div class="auto-grid library-grid">
          <% @collections.each do |collection| %>
            <div>
              <%= render "collections/card", collection: collection %>
              <% if @owned %>
                <%= link_to edit_collection_path(collection), class: "fw-semibold gap-2 d-inline-flex align-items-center profile-manage", aria: { label: "Edit #{collection.name}" } do %>
                  <%= render "collections/icon", name: "edit" %>Edit collection<% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @owned && @collections.any? %>
        <%= link_to "Manage all collections →", my_collections_path, class: "fw-semibold mt-4 d-inline-flex align-items-center profile-all-link" %>
      <% end %>
    </section>

    <section class="mb-5" aria-labelledby="profile-recipes-title">
      <nav class="mb-3">
        <h2 class="fs-5" id="profile-recipes-title">Public recipes</h2>

        <% if @owned %>
          <%= link_to new_recipe_path, class: "fw-semibold gap-2 d-inline-flex align-items-center profile-section-action" do %>
            <%= render "collections/icon", name: "plus" %>New recipe<% end %>
        <% end %>
      </nav>

      <% if @recipes.empty? %>
        <div class="card p-4 d-flex gap-3 align-items-center">
          <%= render "collections/icon", name: "edit" %>

          <hgroup>
            <h3 class="fs-5">
              <%= @owned ? "Your signature drink starts here." : "No public recipes yet." %>
            </h3>
            <p class="m-0"><%= @owned ? "Capture an idea and refine it at your own pace." : "Come back to discover what’s mixed next." %></p>
          </hgroup>
        </div>
      <% else %>
        <div class="auto-grid recipe-grid personal-recipe-grid">
          <% @recipes.each do |recipe| %><%= render "recipes/recipe", recipe: recipe %><% end %>
        </div>
      <% end %>

      <% if @owned && @recipes.any? %>
        <%= link_to "Manage all recipes →", my_recipes_path, class: "fw-semibold mt-4 d-inline-flex align-items-center profile-all-link" %>
      <% end %>
    </section>
  </article>
</div>
