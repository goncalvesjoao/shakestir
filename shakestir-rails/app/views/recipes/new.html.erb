<% content_for :title, "New recipe" %>

<article class="content-grid mt-3 mt-md-4">
  <header>
    <hgroup>
      <h1>New recipe</h1>
      <p>Start with an idea. Refine it at your own pace.</p>
    </hgroup>
  </header>

  <%= render "form", recipe: @recipe %>

  <footer class="nav">
    <ul></ul>

    <nav>
      <%= button_tag "Create", form: "recipe-form", data: { turbo_submits_with: "Creating..." } %>
      <%= button_tag "Cancel", onclick: "app.goBack(this)", class: "secondary" %>
    </nav>
  </footer>
</article>
