<% content_for :title, "Create account" %>

<article class="content-grid mt-3 mt-md-4">
  <turbo-frame id="new_registration_frame" class="px-0 mx-0 mx-md-5 px-md-5">
    <header>
      <hgroup>
        <h1>Create your account</h1>
        <p>Keep your favorite recipes together. Your profile is public. Your recipes and collections start private.</p>
      </hgroup>
    </header>

    <%= flash_messages %>

    <%= form_with model: @user, url: registration_path, class: "card", id: "new_registration_form" do |form| %>
      <fieldset>
        <%= form.label :email_address %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", value: params[:email_address] %>
      </fieldset>

      <fieldset>
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
      </fieldset>

      <fieldset>
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      </fieldset>
    <% end %>

    <footer>
      <%= button_tag "Create account", class: "w-100", form: "new_registration_form", data: { turbo_submits_with: "Creating account..." } %>

      <hr class="my-4">

      <nav class="vstack">
        <%= link_to "Already have an account? Log in", new_session_path, data: { turbo_frame: "_top" } %>
      </nav>
    </footer>
  </turbo-frame>
</article>
