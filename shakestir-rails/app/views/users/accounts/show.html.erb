<% content_for :title, "My account" %>

<div class="content-grid">
  <div class="row mt-5">
    <article class="col-12 col-md-8 col-offset-md-2">
      <header>
        <hgroup>
          <h1>My account</h1>
          <p>Your private account details.</p>
        </hgroup>
      </header>

      <section class="py-3" aria-labelledby="account-details-heading">
        <h2 class="mb-2 fs-4" id="account-details-heading">Email address</h2>
        <p class="mb-0"><%= @user.email_address %></p>
      </section>

      <hr>

      <section class="mt-4">
        <header>
          <hgroup>
            <h2>Delete account</h2>
            <p>This permanently deletes your profile, uploaded photos, all your recipes (including published recipes), collections, Favorites, and sign-in sessions. Your recipes will also be removed from other people’s collections. This cannot be undone.</p>
          </hgroup>
        </header>

        <%= form_with url: user_account_path("my"), method: :delete, class: "card", id: "delete-account-form", data: { turbo_confirm: "Permanently delete your account and all your recipes, collections, and photos? This cannot be undone." } do |form| %>
          <% if @user.errors.any? %><div class="p-3 mb-4 rounded library-errors" role="alert"><strong>Account was not deleted</strong><ul class="mb-0 ps-4"><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>

          <fieldset class="mt-2">
            <%= form.label :password, "Confirm your current password" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", aria: { describedby: "delete-account-help" } %>
            <small id="delete-account-help">Enter your password to confirm that you want to delete this account.</small>
          </fieldset>
        <% end %>
      </section>

      <footer>
        <nav>
          <ul></ul>
          <ul>
            <li><%= button_tag "Delete my account", class: "danger ghost", form: "delete-account-form", data: { turbo_submits_with: "Deleting..." } %></li>
            <li><%= button_tag "Cancel", onclick: "app.goBack(this)", class: "secondary" %></li>
          </ul>
        </nav>
      </footer>
    </article>
  </div>
</div>
