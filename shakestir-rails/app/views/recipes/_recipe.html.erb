<article id="<%= dom_id recipe %>">
  <%= link_to(recipe_path(recipe), class: "d-flex flex-column overflow-hidden", tabindex: "-1", aria: { hidden: true }) do %>
    <%= image_tag(
      recipe_attachment_path(recipe, size: :card),
      alt: "Photo of #{recipe.display_name}",
      loading: "lazy",
      class: "w-100"
    ) %>
  <% end %>

  <h3>
    <%= link_to recipe_author(recipe), profile_path(recipe.user) %>
    <span>/</span>
    <%= link_to recipe.display_name.presence || "Untitled recipe", recipe_path(recipe) %>
  </h3>
</article>
