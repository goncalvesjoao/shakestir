<% content_for :title, "#{@owned ? "My" : @user.profile_name} profile" %>

<div class="content-grid">
  <div class="row mt-5">
    <article class="col-12 col-md-8 col-offset-md-2">
      <header class="row g-4 align-items-start align-items-md-center">
        <div class="col-12 col-md-2 overflow-hidden">
          <%= profile_avatar(@user, image_class: "w-100 h-100 object-fit-cover rounded-circle") %>
        </div>

        <div class="col-12 col-md-10">
          <hgroup>
            <h1 class="mb-2">
              <%= @user.profile_name %>

              <% if @owned %>
                <%= link_to edit_user_profile_path(@user), class: "ms-2" do %>
                  <%= icon_svg_tag "pencil" %>
                <% end %>
              <% end %>
            </h1>

            <p><%= @user.bio %></p>
          </hgroup>

          <div class="mt-3 d-flex gap-2">
            <span>@<%= @user.handle %></span>
            <span>Joined <%= @user.created_at.strftime("%B %Y") %></span>
          </div>
        </div>
      </header>

      <section id="profile-collections" class="my-5" aria-labelledby="profile-collections-title">
        <nav class="mb-3">
          <h2 class="fs-5" id="profile-collections-title">Public collections</h2>
          
          <% if @owned %>
            <%= link_to user_collections_path("my"), class: "d-inline-flex align-items-center" do %>
              <span>Manage collections</span><%= icon_svg_tag "arrow-narrow-right" %>
            <% end %>
          <% end %>
        </nav>

        <% if @collections.empty? %>
          <div class="card p-4 d-flex gap-3 align-items-center">
            <%= icon_svg_tag "bookmarks", class: "text-muted" %>

            <hgroup>
              <h3 class="fs-5">
                <%= @owned ? "Keep your favorites together." : "No public collections yet." %>
              </h3>
              <p>
                <%= @owned ? "Create a collection for an occasion, a mood, or a drink you love." : "This member hasn’t shared a collection yet." %>
              </p>
            </hgroup>
          </div>
        <% else %>
          <div class="auto-grid library-grid">
            <% @collections.each do |collection| %>
              <%= render "collection", collection: collection %>
            <% end %>
          </div>
        <% end %>
      </section>

      <section class="mb-5" aria-labelledby="profile-recipes-title">
        <nav class="mb-3">
          <h2 class="fs-5" id="profile-recipes-title">Public recipes</h2>

          <% if @owned %>
            <%= link_to user_recipes_path("my"), class: "d-inline-flex align-items-center" do %>
              <span>Manage recipes</span><%= icon_svg_tag "arrow-narrow-right" %>
            <% end %>
          <% end %>
        </nav>

        <% if @recipes.empty? %>
          <div class="card p-4 d-flex gap-3 align-items-center">
            <%= icon_svg_tag "cold-drink", class: "text-muted" %>

            <hgroup>
              <h3 class="fs-5"><%= @owned ? "Your signature drink starts here." : "No public recipes yet." %></h3>
              <p><%= @owned ? "Capture an idea and refine it at your own pace." : "Come back to discover what's mixed next." %></p>
            </hgroup>
          </div>
        <% else %>
          <div class="auto-grid recipe-grid personal-recipe-grid">
            <% @recipes.each do |recipe| %>
              <%= render "recipe", recipe: recipe %>
            <% end %>
          </div>
        <% end %>
      </section>
    </article>
  </div>
</div>
