<% content_for :title, "Reset password " %>

<article class="content-grid mt-3 mt-md-4">
  <turbo-frame id="new_session_frame" class="px-0 mx-0 mx-md-5 px-md-5">
    <header>
      <hgroup>
        <h1>Reset your password</h1>
        <p>Enter your account’s email address. We’ll send a link to choose a new password.</p>
      </hgroup>
    </header>

    <%= flash_messages %>

    <%= form_with url: passwords_path, class: "card", id: "new_password_form" do |form| %>
      <fieldset>
        <%= form.label :email_address %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", value: params[:email_address] %>
      </fieldset>
    <% end %>

    <footer>
      <%= button_tag "Email reset instructions", class: "w-100", form: "new_password_form", data: { turbo_submits_with: "Sending…" } %>

      <hr class="my-4">

      <nav class="vstack">
        <%= link_to "Back to sign in", new_session_path, data: { turbo_frame: "_top" } %>
      </nav>
    </footer>
  </turbo-frame>
</article>
