<% content_for :title, "#{@recipe.display_name} · ShakeStir" %>
<div class="detail-page recipe-detail-page full-width content-grid" data-controller="cocktail-panel" data-action="turbo:before-cache@window->cocktail-panel#close">
  <%= render "details", recipe: @recipe %>
  <% panel_title = @cocktail ? "#{@cocktail.display_name} cocktail details" : "#{@recipe.user.profile_name} profile" %>
    <dialog id="cocktail-panel" class="position-fixed mw-100 m-0 p-0 cocktail-panel" aria-label="<%= panel_title %>" data-cocktail-panel-target="dialog" data-action="click->cocktail-panel#backdrop close->cocktail-panel#restoreFocus">
      <div class="position-absolute d-flex cocktail-panel-actions">
        <%= link_to (@cocktail ? cocktail_path(@cocktail) : profile_path(@recipe.user)), data: { cocktail_panel_target: "external" }, target: "_blank", rel: "noopener", class: "cocktail-panel-external secondary button", aria: { label: "Open cocktail details in a new tab" }, title: "Open cocktail details in a new tab" do %>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3h7v7M21 3 10 14M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5" /></svg>
        <% end %>
        <button type="button" class="m-0 cocktail-panel-close secondary" data-action="cocktail-panel#close" aria-label="Close cocktail details" title="Close cocktail details">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
        </button>
      </div>
      <iframe title="<%= panel_title %>" data-cocktail-panel-target="frame"></iframe>
    </dialog>
</div>
