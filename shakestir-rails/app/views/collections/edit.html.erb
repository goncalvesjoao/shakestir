<% content_for :title, "Edit #{@collection.name} · ShakeStir" %>
<div class="library-page library-editor">
  <%= link_to @collection, class: "gap-2 mb-4 d-inline-flex align-items-center library-back" do %><%= render "icon", name: "back" %>Back to collection<% end %>
  <header class="d-flex justify-content-between library-heading"><div><h1>Edit collection</h1><p class="m-0 library-description">Give it a name. Choose who can see it.</p></div></header>
  <%= render "form", collection: @collection %>
  <% unless @collection.system_key == "favorites" %>
  <details class="mt-4 library-danger"><summary>Delete collection</summary><p>This permanently deletes the collection. Your recipes will stay in ShakeStir.</p><%= button_to "Delete collection", @collection, method: :delete, class: "library-delete", data: { turbo_confirm: "Delete #{@collection.name}? This cannot be undone. Your recipes will not be deleted." } %></details>
  <% end %>
</div>
