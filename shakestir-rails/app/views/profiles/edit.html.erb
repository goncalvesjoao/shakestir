<% content_for :title, "Edit profile · ShakeStir" %>
<div class="library-page library-editor profile-editor">
  <%= link_to my_profile_path, class: "gap-2 mb-4 d-inline-flex align-items-center library-back" do %><%= render "collections/icon", name: "back" %>My profile<% end %>
  <header class="align-items-start align-items-md-center gap-3 gap-md-4 flex-column flex-md-row d-flex justify-content-between library-heading"><div><h1>Edit profile</h1><p class="m-0 library-description">Your profile is public. Your recipes and collections keep their own visibility settings.</p></div></header>
  <%= form_with model: @profile, url: my_profile_path, method: :patch, class: "p-4 shadow-none library-form" do |form| %>
    <% if @profile.errors.any? %><div class="p-3 mb-4 rounded library-errors" role="alert"><strong>Check your profile details</strong><ul class="mb-0 ps-4"><% @profile.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
    <div class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section profile-photo-editor">
      <%= form.label :image, "Profile picture", class: "fw-semibold mb-2" %>
      <div class="fw-semibold d-grid rounded-circle overflow-hidden profile-avatar"><%= profile_avatar(@profile, image_class: "w-100 h-100 object-fit-cover") %></div>
      <p id="profile-photo-help">Upload a JPEG, PNG, or WebP, up to 10 MB. Your profile and photo are public. Without one, we’ll use your avatar.</p>
      <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", aria: { describedby: "profile-photo-help" } %>
      <% if @profile.image.attached? %><label class="gap-2 mt-2 d-flex align-items-center profile-photo-remove"><%= check_box_tag "user[remove_image]", "1", false, class: "m-0 flex-shrink-0" %>Remove photo and use my avatar</label><% end %>
    </div>
    <div class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section"><%= form.label :handle, "Handle", class: "fw-semibold mb-2" %><p id="profile-handle-help">Your public handle starts from your email name and credits your recipes. You can change it here. Use 3–40 lowercase letters, numbers, hyphens or underscores.</p><%= form.text_field :handle, required: true, minlength: 3, maxlength: 40, aria: { describedby: "profile-handle-help" }, class: "m-0 rounded" %></div>
    <div class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section"><%= form.label :display_name, "Display name", class: "fw-semibold mb-2" %><p id="profile-name-help">The name people see on your public profile. Your email stays private.</p><%= form.text_field :display_name, maxlength: 80, autocomplete: "nickname", placeholder: "What should we call you?", aria: { describedby: "profile-name-help" }, class: "m-0 rounded" %></div>
    <div class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section"><%= form.label :bio, "About you", class: "fw-semibold mb-2" %><p id="profile-bio-help">A favorite drink, a little inspiration, or a few words about you. Up to 280 characters.</p><%= form.textarea :bio, rows: 3, maxlength: 280, placeholder: "Usually experimenting with…", aria: { describedby: "profile-bio-help" }, class: "mb-0 rounded" %></div>

    <div class="pt-4 border-top gap-4 d-flex align-items-center flex-wrap library-form-actions"><%= form.submit "Save changes", class: "text-nowrap gap-2 d-inline-flex justify-content-center align-items-center m-0 library-action primary size-md w-auto", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", my_profile_path, class: "d-inline-flex align-items-center library-cancel" %></div>
  <% end %>
</div>
