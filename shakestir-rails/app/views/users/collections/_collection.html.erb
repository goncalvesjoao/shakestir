<article class="card">
  <nav class="align-items-start">
    <hgroup>
      <h3><%= collection.name %></h3>
      <p class="d-flex gap-2">
        <span><%= pluralize(@recipe_counts.fetch(collection.id, 0), "recipe") %></span>

        <small>
          <%= icon_svg_tag({ public: "world", private: "lock-filled" }[collection.visibility.to_sym]) %>
          <%= collection.visibility.capitalize %>
        </small>
      </p>
    </hgroup>

    <ul>
      <li>
        <%= modal_link_to edit_collection_path(collection), modal: "edit-collection-#{collection.id}" do %>
          <%= icon_tag "pencil", text: "Edit" %>
        <% end %>
      </li>

      <li>
        <%= link_to collection_path(collection), class: "danger", data: { turbo_confirm: "Are you sure?", turbo_method: :delete } do %>
          <%= icon_tag "trash-filled", text: "Delete" %>
        <% end %>
      </li>
    </ul>
  </nav>
</article>
