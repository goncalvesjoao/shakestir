<% content_for :title, "Create account · ShakeStir" %>
<section class="p-4 shadow-none card form-page auth-page" aria-labelledby="registration-title">
  <h1 class="mb-2" id="registration-title">Create your account</h1>
  <p>Keep your favorite recipes together. Your profile is public. Your recipes and collections start private.</p>
  <% if @user.errors.any? %>
    <div role="alert" class="p-3 mb-4 rounded library-errors"><strong>Check your account details</strong><ul class="mb-0 ps-4"><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>
  <%= form_with model: @user, url: registration_path, class: "d-grid gap-2 mt-4" do |form| %>
    <%= form.label :email_address %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "w-100" %>
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "w-100" %>
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "w-100" %>
    <%= form.submit "Create account", data: { turbo_submits_with: "Creating account…" }, class: "w-100" %>
  <% end %>
  <div class="d-grid gap-1 mt-4 pt-3 auth-links"><%= link_to "Already have an account? Log in", new_session_path, class: "d-inline-flex align-items-center" %></div>
</section>
