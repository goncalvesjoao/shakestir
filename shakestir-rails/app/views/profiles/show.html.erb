<% content_for :body_class, "cocktail-panel-content profile-panel-content" if params[:panel] == "1" %>
<% content_for :title, "#{@owned ? "My profile" : @profile.profile_name} · ShakeStir" %>
<div class="library-page profile-page">
  <header class="align-items-start align-items-md-center gap-4 flex-wrap flex-md-nowrap d-flex profile-heading">
    <div class="fw-semibold d-grid rounded-circle overflow-hidden profile-avatar"><%= profile_avatar(@profile, image_class: "w-100 h-100 object-fit-cover") %></div>
    <div class="profile-intro"><h1 class="mb-2"><%= @profile.profile_name %></h1>
      <% if @profile.bio.present? %><p class="profile-bio"><%= @profile.bio %></p><% end %>
      <div class="row-gap-2 column-gap-3 d-flex flex-wrap align-items-center profile-meta"><span>@<%= @profile.handle %></span><span>Joined <%= @profile.created_at.strftime("%B %Y") %></span></div>
    </div>
    <% if @owned %><%= link_to edit_my_profile_path, class: "m-0 text-nowrap gap-2 d-inline-flex justify-content-center align-items-center button library-action secondary size-md" do %><%= render "collections/icon", name: "edit" %>Edit profile<% end %><% end %>
  </header>
  <nav class="mb-5 border-bottom gap-4 d-flex profile-sections" aria-label="Profile sections"><a class="d-inline-flex align-items-center gap-2 fw-semibold text-decoration-none py-2" href="#profile-collections">Collections <span class="fw-normal"><%= @collections.size %></span></a><a class="d-inline-flex align-items-center gap-2" href="#profile-recipes">Recipes <span class="fw-normal"><%= @recipes.size %></span></a></nav>
  <section id="profile-collections" class="mb-5 profile-content" aria-labelledby="profile-collections-title">
    <div class="mb-4 gap-2 d-flex align-items-baseline justify-content-between flex-wrap library-section-label"><h2 class="m-0 fs-5" id="profile-collections-title">Public collections</h2><% if @owned %><%= link_to new_collection_path, class: "fw-semibold gap-2 d-inline-flex align-items-center profile-section-action" do %><%= render "collections/icon", name: "plus" %>Create collection<% end %><% end %></div>
    <% if @collections.empty? %>
      <div class="gap-3 p-4 flex-wrap flex-md-nowrap d-flex align-items-center profile-empty"><%= render "collections/icon", name: "collection" %><div><h3 class="mt-0 mx-0 mb-2 fs-5"><%= @owned ? "Keep your favorites together." : "No public collections yet." %></h3><p class="m-0"><%= @owned ? "Create a collection for an occasion, a mood, or a drink you love." : "This member hasn’t shared a collection yet." %></p></div><% if @owned %><%= link_to "Create collection", new_collection_path, class: "m-0 text-nowrap gap-2 d-inline-flex justify-content-center align-items-center button library-action secondary size-md" %><% end %></div>
    <% else %>
      <div class="auto-grid library-grid"><% @collections.each do |collection| %><div><%= render "collections/card", collection: collection %><% if @owned %><%= link_to edit_collection_path(collection), class: "fw-semibold gap-2 d-inline-flex align-items-center profile-manage", aria: { label: "Edit #{collection.name}" } do %><%= render "collections/icon", name: "edit" %>Edit collection<% end %><% end %></div><% end %></div>
    <% end %>
    <% if @owned && @collections.any? %><%= link_to "Manage all collections →", my_collections_path, class: "fw-semibold mt-4 d-inline-flex align-items-center profile-all-link" %><% end %>
  </section>
  <section id="profile-recipes" class="mb-5 profile-content" aria-labelledby="profile-recipes-title">
    <div class="mb-4 gap-2 d-flex align-items-baseline justify-content-between flex-wrap library-section-label"><h2 class="m-0 fs-5" id="profile-recipes-title">Public recipes</h2><% if @owned %><%= link_to new_recipe_path, class: "fw-semibold gap-2 d-inline-flex align-items-center profile-section-action" do %><%= render "collections/icon", name: "plus" %>New recipe<% end %><% end %></div>
    <% if @recipes.empty? %>
      <div class="gap-3 p-4 flex-wrap flex-md-nowrap d-flex align-items-center profile-empty"><%= render "collections/icon", name: "edit" %><div><h3 class="mt-0 mx-0 mb-2 fs-5"><%= @owned ? "Your signature drink starts here." : "No public recipes yet." %></h3><p class="m-0"><%= @owned ? "Capture an idea and refine it at your own pace." : "Come back to discover what’s mixed next." %></p></div><% if @owned %><%= link_to "Create recipe", new_recipe_path, class: "m-0 text-nowrap gap-2 d-inline-flex justify-content-center align-items-center button library-action secondary size-md" %><% end %></div>
    <% else %>
      <div class="auto-grid recipe-grid personal-recipe-grid"><% @recipes.each do |recipe| %><%= render "recipes/recipe", recipe: recipe %><% end %></div>
    <% end %>
    <% if @owned && @recipes.any? %><%= link_to "Manage all recipes →", my_recipes_path, class: "fw-semibold mt-4 d-inline-flex align-items-center profile-all-link" %><% end %>
  </section>
</div>
