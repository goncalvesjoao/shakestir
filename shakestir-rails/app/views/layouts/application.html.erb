<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "ShakeStir" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ShakeStir">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "semanticus", "theme", "cocktail-details", "collections", "my-recipes", "profiles", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

  </head>

  <body class="<%= content_for :body_class %>">
    <a href="#main-content" class="visually-hidden-focusable">Skip to content</a>
    <header class="position-sticky top-0 site-header content-grid">
      <nav class="d-grid align-items-center row-gap-1 column-gap-3 gap-lg-4 py-2" aria-label="Main navigation">
        <%= link_to root_path, class: "d-flex align-items-center text-decoration-none brand-link" do %>
          <%= render "shared/wordmark" %>
        <% end %>
        <ul class="d-flex align-items-center gap-4 m-0 p-0 flex-nowrap overflow-x-auto primary-navigation">
          <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Explore", root_path, aria: { current: ("page" if controller_name == "recipes" && %w[index show].include?(action_name)) } %></li>
          <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Cocktails", cocktails_path, aria: { current: ("page" if controller_name == "cocktails") } %></li>
          <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Ingredients", ingredients_path, aria: { current: ("page" if controller_name == "ingredients") } %></li>
          <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Tools", utensils_path, aria: { current: ("page" if controller_name == "utensils") } %></li>
          <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Methods", techniques_path, aria: { current: ("page" if controller_name == "techniques") } %></li>
          <% if authenticated? %>
            <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "My recipes", my_recipes_path, aria: { current: ("page" if controller_name == "account" && action_name == "recipes") } %></li>
            <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "My collections", my_collections_path, aria: { current: ("page" if controller_name == "collections") } %></li>
          <% end %>
        </ul>
        <ul class="d-flex align-items-center gap-2 gap-md-4 m-0 p-0 flex-nowrap navigation-actions">
          <% if authenticated? %>
            <li class="d-flex align-items-center my-0 flex-shrink-0">
              <details class="position-relative account-dropdown">
                <summary class="d-flex align-items-center gap-2 rounded-circle" aria-label="User account">
                  <%= profile_avatar(Current.user, size: 40, css_class: "rounded-circle object-fit-cover user-avatar") %>
                </summary>
                <div class="end-0 p-2 position-absolute account-dropdown-items">
                  <%= link_to "My profile", my_profile_path, class: "d-block w-100 p-3 text-start text-nowrap border-0 m-0 text-reset text-decoration-none shadow-none" %>
                  <%= link_to "My account", my_account_path, class: "d-block w-100 p-3 text-start text-nowrap border-0 m-0 text-reset text-decoration-none shadow-none" %>
                  <%= link_to "Log out", session_path, data: { turbo_method: :delete }, class: "d-block w-100 p-3 text-start text-nowrap border-0 m-0 text-reset text-decoration-none shadow-none" %>
                </div>
              </details>
            </li>
          <% else %>
            <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Log in", new_session_path %></li>
            <li class="d-flex align-items-center my-0 flex-shrink-0"><%= link_to "Create account", new_registration_path, class: "text-nowrap d-inline-flex align-items-center button navigation-create" %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <%= flash_messages %>

    <main id="main-content" class="content-grid">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
