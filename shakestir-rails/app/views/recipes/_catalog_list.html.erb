<details id="matching-recipes" class="pt-4 cocktail-recipe-accordion">
  <summary class="fs-5 fw-semibold">Recipes (<%= recipes.size %>)</summary>
  <% if recipes.empty? %><p><%= local_assigns[:empty_message] || "No recipes yet." %></p><% end %>
  <div class="mt-4 auto-grid recipe-grid recipe-catalog-grid compact-recipe-grid"><%= render recipes %></div>
</details>
