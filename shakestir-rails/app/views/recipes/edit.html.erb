<% content_for :title, "Edit #{@recipe.display_name.presence || "recipe"}" %>

<%= main_tag do %>
  <%= turbo_frame_tag(dom_id(@recipe, :edit)) do %>
    <%= header_tag do %>
      <hgroup>
        <h1>Edit <%= @recipe.display_name.presence || "recipe" %></h1>
        <p><%= @recipe.display_name.presence || "A little refinement goes a long way." %></p>
      </hgroup>
    <% end %>

    <%= render "form", recipe: @recipe %>

    <footer class="nav">
      <ul></ul>

      <nav>
        <%= button_tag "Update", form: "recipe-form", data: { turbo_submits_with: "Updating..." } %>
        <%= button_tag "Cancel", onclick: "app.goBack(this)", class: "secondary" %>
      </nav>
    </footer>
  <% end %>
<% end %>
