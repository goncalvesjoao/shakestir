<% content_for :title, "My account · ShakeStir" %>
<div class="library-page library-editor account-page">
  <header class="align-items-start align-items-md-center gap-3 gap-md-4 flex-column flex-md-row d-flex justify-content-between library-heading"><div><h1>My account</h1><p class="m-0 library-description">Your private account details.</p></div></header>
  <section class="py-3 account-details" aria-labelledby="account-details-heading">
    <h2 class="mb-2 fs-4" id="account-details-heading">Email address</h2>
    <p class="account-email"><%= @account.email_address %></p>
    <p class="account-help">Only you can see this page. Your email is not shown on your public profile.</p>
  </section>
  <section class="mt-4 pt-4 border-top account-deletion" aria-labelledby="delete-account-heading">
    <h2 class="mb-2" id="delete-account-heading">Delete account</h2>
    <p>This permanently deletes your profile, uploaded photos, all your recipes (including published recipes), collections, Favorites, and sign-in sessions. Your recipes will also be removed from other people’s collections. This cannot be undone.</p>
    <%= form_with url: my_account_path, method: :delete, class: "p-4 shadow-none library-form", data: { turbo_confirm: "Permanently delete your account and all your recipes, collections, and photos? This cannot be undone." } do |form| %>
      <% if @account.errors.any? %><div class="p-3 mb-4 rounded library-errors" role="alert"><strong>Account was not deleted</strong><ul class="mb-0 ps-4"><% @account.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
      <%= form.label :password, "Confirm your current password" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", aria: { describedby: "delete-account-help" } %>
      <p id="delete-account-help">Enter your password to confirm that you want to delete this account.</p>
      <div class="pt-4 border-top gap-4 d-flex align-items-center flex-wrap library-form-actions"><%= form.submit "Delete my account", class: "w-auto m-0 danger ghost", data: { turbo_submits_with: "Deleting…" } %></div>
    <% end %>
  </section>
</div>
