<% content_for :title, "#{@user.display_name} recipes" %>

<div class="content-grid">
  <div class="row mt-5">
    <article class="col-12 col-md-8 col-offset-md-2">
      <header>
        <nav>
          <hgroup>
            <h1><%= @user.display_name %>'s recipes</h1>
            <p>Good recipes, kept together. Ready for your next pour.</p>
          </hgroup>

          <ul>
            <li><%= link_to "New Recipe", new_recipe_path, class: "button" %></li>
          </ul>
        </nav>
      </header>

      <% @recipes.each do |recipe| %>
        <%= render "recipe", recipe: recipe %>
      <% end %>
    </article>
  </div>
</div>
