<% content_for :title, "#{@collection.name}" %>
<% owned = Current.user == @collection.user %>
<div class="library-page">
  <%= link_to owned ? my_collections_path : cocktails_path, class: "gap-2 mb-4 d-inline-flex align-items-center library-back" do %><%= render "icon", name: "back" %><%= owned ? "My collections" : "Explore recipes" %><% end %>
  <header class="gap-3 gap-md-4 mb-4 d-grid library-detail-heading">
    <%= render "artwork", collection: @collection, recipes: @recipes.first(4) %>
    <div class="library-detail-copy"><h1><%= @collection.name %></h1>
      <p class="profile-byline">Collected by <%= link_to @collection.user.profile_name, user_profile_path(@collection.user) %></p>
      <div class="mb-3 row-gap-2 column-gap-3 d-flex align-items-center flex-wrap library-detail-meta"><span class="gap-1 d-inline-flex align-items-center library-visibility"><%= render "icon", name: @collection.visibility %><%= @collection.visibility.capitalize %></span><span><%= pluralize(@recipes.size, "recipe") %></span></div>
      <p class="m-0 library-description"><%= @collection.visibility == "private" ? "Just for you. Only you can see this collection." : "Made to share. Anyone with the link can view this collection." %></p>
      <% if owned %><%= link_to edit_collection_path(@collection), class: "m-0 text-nowrap gap-2 d-inline-flex justify-content-center align-items-center button library-action secondary size-md" do %><%= render "icon", name: "edit" %>Edit collection<% end %><% end %>
    </div>
  </header>
  <% if @recipes.empty? %>
    <section class="p-5 d-flex flex-column align-items-center text-center library-empty"><span class="d-grid mb-4 library-empty-symbol"><%= render "icon", name: "plus" %></span><h2 class="fs-3 mb-2 lh-sm"><%= owned ? "Your next favorite belongs here." : "No recipes to show yet." %></h2><p><%= owned ? "Explore a recipe, tap + on its image, and choose this collection." : "Come back to see what’s added next." %></p><%= link_to "Explore recipes", cocktails_path, class: "text-nowrap gap-2 d-inline-flex justify-content-center m-0 align-items-center button library-action primary size-md" %></section>
  <% else %>
    <div class="mb-4 gap-2 d-flex align-items-baseline justify-content-between flex-wrap library-section-label"><h2 class="m-0 fs-5">Recipes</h2><span>Recently added first</span></div>
    <div class="auto-grid recipe-grid library-recipes">
      <% @recipes.each do |recipe| %>
        <div class="library-recipe"><%= render recipe %>
          <% if owned %><%= button_to "Remove from collection", collection_collection_recipe_path(@collection, recipe), method: :delete, class: "border-0 shadow-none m-0 library-remove", aria: { label: "Remove #{recipe.display_name} from #{@collection.name}" } %><% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
