<footer class="gap-0 site-footer content-grid">
  <div class="d-flex justify-content-between flex-wrap footer-content">
    <div class="footer-brand">
      <%= link_to root_path, class: "brand-link" do %>
        <%= render "shared/wordmark" %>
      <% end %>
      <p>Find a drink. Make it yours.</p>
      <small>&copy; <%= Date.current.year %> ShakeStir</small>
    </div>
    <nav class="d-flex flex-wrap footer-navigation" aria-label="Policies and help">
      <div>
        <h2>Policies</h2>
        <ul class="d-block m-0 p-0">
          <li class="d-block"><%= link_to "Terms of service", terms_path, class: "d-inline-flex align-items-center" %></li>
          <li class="d-block"><%= link_to "Privacy policy", privacy_path, class: "d-inline-flex align-items-center" %></li>
          <li class="d-block"><%= link_to "Cookie policy", cookies_path, class: "d-inline-flex align-items-center" %></li>
        </ul>
      </div>
      <div>
        <h2>Using ShakeStir</h2>
        <ul class="d-block m-0 p-0">
          <li class="d-block"><%= link_to "Community guidelines", community_guidelines_path, class: "d-inline-flex align-items-center" %></li>
          <li class="d-block"><%= link_to "Responsible drinking", responsible_drinking_path, class: "d-inline-flex align-items-center" %></li>
          <li class="d-block"><%= link_to "Help & contact", help_path, class: "d-inline-flex align-items-center" %></li>
        </ul>
      </div>
    </nav>
  </div>
</footer>
