<% panel_data = { action: "cocktail-panel#open", cocktail_panel_target: "trigger", panel_title: "#{cocktail.display_name} details", panel_kind: "cocktail details" } %>
<article id="<%= dom_id cocktail %>" class="catalog-card">
  <div class="position-relative card-media">
    <%= link_to cocktail_path(cocktail), class: "d-block overflow-hidden card-image catalog-card-image", tabindex: "-1", data: panel_data, aria: { hidden: true } do %>
      <% if cocktail.image.attached? %>
        <%= image_tag cocktail_image_path(cocktail, size: :card), alt: "", loading: "lazy" %>
      <% else %>
        <span class="d-grid h-100 photo-placeholder">J<span aria-hidden="true">.</span></span>
      <% end %>
    <% end %>
  </div>
  <div class="card-copy">
    <h3><%= link_to cocktail.display_name, cocktail_path(cocktail), data: panel_data, aria: { haspopup: "dialog", controls: "cocktail-panel" } %></h3>
  </div>
</article>
