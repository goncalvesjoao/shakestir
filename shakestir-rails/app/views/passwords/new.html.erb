<% content_for :title, "Reset password " %>

<div class="content-grid">
  <div class="row mt-4 mt-md-5">
    <article class="card p-4 col-10 col-offset-1 col-md-8 col-offset-md-2 col-lg-6 col-offset-lg-3">
      <hgroup>
        <h1>Reset your password</h1>
        <p>Enter your account’s email address. We’ll send a link to choose a new password.</p>
      </hgroup>

      <%= flash_messages %>

      <%= form_with url: passwords_path, class: "mt-4" do |form| %>
        <fieldset>
          <%= form.label :email_address %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", value: params[:email_address] %>
        </fieldset>

        <%= form.submit "Email reset instructions", class: "mt-2 mb-0", data: { turbo_submits_with: "Sending…" } %>      
      <% end %>

      <hr class="my-4">

      <nav class="vstack">
        <%= link_to "Back to sign in", new_session_path %>
      </nav>
    </article>
  </div>
</div>
