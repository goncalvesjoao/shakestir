<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "ShakeStir" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ShakeStir">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "semanticus", "theme", "marketplace", "cocktail-details", "collections", "my-recipes", "profiles", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

  </head>

  <body class="<%= content_for :body_class %>">
    <a href="#main-content" class="visually-hidden-focusable">Skip to content</a>
    <header class="site-header content-grid">
      <nav aria-label="Main navigation">
        <%= link_to root_path, class: "brand-link" do %>
          <%= render "shared/wordmark" %>
        <% end %>
        <ul class="primary-navigation">
          <li><%= link_to "Explore", root_path, aria: { current: ("page" if controller_name == "recipes" && %w[index show].include?(action_name)) } %></li>
          <li><%= link_to "Cocktails", cocktails_path, aria: { current: ("page" if controller_name == "cocktails") } %></li>
          <li><%= link_to "Ingredients", ingredients_path, aria: { current: ("page" if controller_name == "ingredients") } %></li>
          <li><%= link_to "Tools", utensils_path, aria: { current: ("page" if controller_name == "utensils") } %></li>
          <li><%= link_to "Methods", techniques_path, aria: { current: ("page" if controller_name == "techniques") } %></li>
          <% if authenticated? %>
            <li><%= link_to "My recipes", my_recipes_path, aria: { current: ("page" if controller_name == "account" && action_name == "recipes") } %></li>
            <li><%= link_to "My collections", my_collections_path, aria: { current: ("page" if controller_name == "collections") } %></li>
          <% end %>
        </ul>
        <ul class="navigation-actions">
          <% if authenticated? %>
            <li>
              <details class="position-relative account-dropdown">
                <summary aria-label="User account">
                  <%= profile_avatar(Current.user, size: 40, css_class: "rounded-circle object-fit-cover user-avatar") %>
                </summary>
                <div class="position-absolute account-dropdown-items">
                  <%= link_to "My profile", my_profile_path %>
                  <%= link_to "My account", my_account_path %>
                  <%= link_to "Log out", session_path, data: { turbo_method: :delete } %>
                </div>
              </details>
            </li>
          <% else %>
            <li><%= link_to "Log in", new_session_path %></li>
            <li><%= link_to "Create account", new_registration_path, class: "d-inline-flex align-items-center button navigation-create" %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <%= flash_messages %>

    <main id="main-content" class="content-grid">
      <%= yield %>
    </main>
    <footer class="justify-content-between site-footer"><%= render "shared/wordmark" %><span>Find a drink. Make it yours.</span></footer>
  </body>
</html>
