<%= form_with model: collection, class: "shadow-none library-form" do |form| %>
  <% if collection.errors.any? %><div class="library-errors" role="alert"><strong>Check your collection details</strong><ul><% collection.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section"><%= form.label :name, "Collection name" %><p id="collection-name-help">A mood, an occasion, or simply your favorites.</p><%= form.text_field :name, required: true, placeholder: "e.g. Friday night favorites", aria: { describedby: "collection-name-help" } %></div>
  <% if collection.system_key == "favorites" %><p>Your starred recipes stay in this private Favorites collection. You can rename it.</p><% else %>
  <fieldset class="border-0 mt-0 mx-0 mb-4 p-0 library-form-section library-privacy"><legend>Who can see this collection?</legend>
    <label class="gap-2 d-flex align-items-center library-privacy-option"><%= form.radio_button :visibility, "private" %><span class="library-privacy-icon"><%= render "icon", name: "private" %></span><span><strong>Private</strong><small>Only you. Keep your discoveries to yourself.</small></span></label>
    <label class="gap-2 d-flex align-items-center library-privacy-option"><%= form.radio_button :visibility, "public" %><span class="library-privacy-icon"><%= render "icon", name: "public" %></span><span><strong>Public</strong><small>Anyone with the link can view this collection.</small></span></label>
  </fieldset>
  <% end %>
  <div class="pt-4 border-top gap-4 d-flex align-items-center flex-wrap library-form-actions"><%= form.submit collection.persisted? ? "Save changes" : "Create collection", class: "gap-2 d-inline-flex justify-content-center align-items-center m-0 library-action primary size-md", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", collection.persisted? ? collection_path(collection) : my_collections_path, class: "d-inline-flex align-items-center library-cancel" %></div>
<% end %>
