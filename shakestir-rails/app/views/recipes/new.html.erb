<% content_for :title, "New recipe" %>

<div class="content-grid">
  <div class="row mt-5">
    <article class="col-12 col-md-8 col-offset-md-2">
      <header>
        <hgroup>
          <h1>New recipe</h1>
          <p>Start with an idea. Refine it at your own pace.</p>
        </hgroup>
      </header>

      <%= render "form", recipe: @recipe %>

      <footer>
        <nav>
          <ul></ul>
          <ul>
            <li><%= button_tag "Create", form: "recipe-form", data: { turbo_submits_with: "Creating..." } %></li>
            <li><%= button_tag "Cancel", onclick: "app.goBack(this)", class: "secondary" %></li>
          </ul>
        </nav>
      </footer>
    </article>
  </div>
</div>
