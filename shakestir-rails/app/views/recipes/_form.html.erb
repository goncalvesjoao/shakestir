<%= form_with model: recipe, class: "p-4 p-md-5 m-0 shadow-none recipe-form recipe-editor-form" do |form| %>
  <% if recipe.errors.any? %>
    <div role="alert" class="p-3 mb-4 rounded library-errors"><strong>Check your recipe details</strong><ul class="mb-0 ps-4"><% recipe.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div>
  <% end %>
  <section class="gap-3 gap-md-5 pb-4 mb-4 border-bottom d-grid recipe-editor-section" aria-labelledby="recipe-basics-title">
    <div class="recipe-section-intro"><h2 class="mt-0 mx-0 mb-2 fs-5" id="recipe-basics-title">The basics</h2><p class="m-0">Give your drink a name and a little character.</p></div>
    <div class="gap-3 d-grid recipe-section-fields">
      <div><%= form.label :name, "Recipe name", class: "d-block fw-semibold mb-2" %><%= form.text_field :name, placeholder: "e.g. My Sunday Negroni", class: "m-0 rounded" %></div>
<div><%= form.label :servings, class: "d-block fw-semibold mb-2" %><%= form.number_field :servings, min: 1, step: 1, class: "m-0 rounded" %></div>
    </div>
  </section>
  <section class="gap-3 gap-md-5 pb-4 mb-4 border-bottom d-grid recipe-editor-section" aria-labelledby="recipe-preparation-title">
    <div class="recipe-section-intro"><h2 class="mt-0 mx-0 mb-2 fs-5" id="recipe-preparation-title">Preparation</h2><p class="m-0">Make it easy to get every pour right.</p></div>
    <div class="gap-3 d-grid recipe-section-fields">
      <p class="rounded p-3 recipe-editor-note">Ingredient and utensil editing isn’t available in this form yet. <%= recipe.recipe_ingredients.any? ? "Your existing requirements are preserved." : "Save your idea as a draft; publishing requires ingredient lines." %></p>
      <% multi_step = recipe.recipe_steps.reject(&:marked_for_destruction?).size > 1 %>
      <div><%= form.label :steps, "Preparation steps", class: "d-block fw-semibold mb-2" %><% if multi_step %><p id="recipe-steps-help" class="rounded p-3 recipe-editor-note">This recipe has multiple steps. They’re shown here for reference and can’t be changed in this editor yet.</p><% end %><%= form.textarea :steps, rows: 6, readonly: multi_step, placeholder: "Add the ingredients, stir with ice, and strain…", aria: { describedby: ("recipe-steps-help" if multi_step) }, class: "m-0 rounded" %></div>
      <fieldset class="border-0 p-0 m-0 technique-options" aria-describedby="recipe-techniques-help">
        <legend class="mb-2 fw-semibold">Techniques used</legend>
        <p id="recipe-techniques-help">Choose all that appear in your steps. Readers can open a beginner guide for each one.</p>
        <% techniques = Technique.order(:slug) %>
        <% if techniques.any? %>
          <div class="auto-grid technique-options-list">
            <%= form.collection_check_boxes :technique_ids, techniques, :id, :display_name do |choice| %>
              <%= choice.label(class: "d-flex align-items-center gap-2 fw-semibold mt-0 mx-0 mb-2") { choice.check_box(class: "m-0") + choice.text } %>
            <% end %>
          </div>
        <% else %>
          <p>No technique guides are available yet.</p>
        <% end %>
      </fieldset>
    </div>
  </section>
  <section class="gap-3 gap-md-5 pb-4 mb-4 border-bottom d-grid recipe-editor-section" aria-labelledby="recipe-photo-title">
    <div class="recipe-section-intro"><h2 class="mt-0 mx-0 mb-2 fs-5" id="recipe-photo-title">A photo to remember</h2><p class="m-0">Optional, but a good drink deserves a good close-up.</p></div>
    <div class="gap-3 d-grid recipe-section-fields"><div class="recipe-photo-field">
      <% if recipe.persisted? && recipe.image.attached? %><%= image_tag recipe_image_path(recipe, size: :card), alt: "Current photo of #{recipe.display_name}", loading: "lazy", class: "mb-3 d-block mw-100 object-fit-cover recipe-editor-photo" %><% end %>
      <%= form.label :image, recipe.image.attached? ? "Replace photo" : "Add a photo", class: "d-block fw-semibold mb-2" %><%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", aria: { describedby: "image-help" }, class: "m-0 rounded p-3 w-100" %><small class="d-block mt-2" id="image-help">JPEG, PNG or WebP. Up to 10 MB and 25 megapixels.<%= " Your current photo stays unless you choose a replacement." if recipe.image.attached? %></small>
    </div></div>
  </section>
  <section class="gap-3 gap-md-5 pb-4 mb-4 border-bottom d-grid recipe-editor-section" aria-labelledby="recipe-sharing-title">
    <div class="recipe-section-intro"><h2 class="mt-0 mx-0 mb-2 fs-5" id="recipe-sharing-title">Saving &amp; sharing</h2><p class="m-0">Keep an idea to yourself or share the finished recipe.</p></div>
    <div class="gap-3 d-grid recipe-section-fields">
      <div><%= form.label :publication_state, "Recipe status", class: "d-block fw-semibold mb-2" %><%= form.select :publication_state, [["Draft", "draft"], ["Published", "published"]], {}, aria: { describedby: "recipe-state-help" }, class: "m-0 rounded" %><small class="d-block mt-2" id="recipe-state-help">Drafts are only visible to you. Publishing requires a name, ingredients, and preparation steps.</small></div>
      <div><%= form.label :visibility, "Visibility", class: "d-block fw-semibold mb-2" %><%= form.select :visibility, [["Private — only you", "private"], ["Public — visible when published", "public"]], {}, aria: { describedby: "recipe-visibility-help" }, class: "m-0 rounded" %><small class="d-block mt-2" id="recipe-visibility-help">A recipe appears in Explore when it’s public and published.</small></div>
    </div>
  </section>
  <details class="py-2 m-0 recipe-editor-extra"><summary class="d-flex align-items-center fw-semibold">Source &amp; inspiration <span class="ms-2 fw-normal">Optional</span></summary><div class="gap-3 d-grid recipe-section-fields"><div><%= form.label :source_reference, "Source or credit", class: "d-block fw-semibold mb-2" %><%= form.text_field :source_reference, placeholder: "A book, a bartender, an inspiration…", class: "m-0 rounded" %></div><div><%= form.label :source_url, "Source link", class: "d-block fw-semibold mb-2" %><%= form.url_field :source_url, placeholder: "https://", class: "m-0 rounded" %></div></div></details>
  <div class="pt-4 mt-3 border-top gap-4 d-flex align-items-center recipe-editor-actions"><%= form.submit recipe.persisted? ? "Save changes" : "Create recipe", class: "text-nowrap gap-2 d-inline-flex justify-content-center align-items-center m-0 library-action primary size-md w-auto", data: { turbo_submits_with: "Saving…" } %><%= link_to "Cancel", recipe.persisted? ? recipe_path(recipe) : my_recipes_path, class: "d-inline-flex align-items-center library-cancel" %></div>
<% end %>
