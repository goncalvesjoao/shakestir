<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">

    <title><%= "#{content_for(:title)} · ShakeStir" || "ShakeStir" %></title>

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ShakeStir">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "semanticus", "theme", "styles", "data-turbo-track": "reload", integrity: true %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header content-grid py-3 border-bottom">
      <nav class="breakout gap-0 flex-wrap" aria-label="Main navigation">
        <%= link_to root_path, class: "brand-link order-0" do %>
          <%= render "shared/wordmark" %>
        <% end %>

        <ul class="primary-navigation order-2 order-md-1">
          <li><%= link_to "Explore", root_path, class: "p-2", aria: { current: ("page" if controller_name == "recipes" && %w[index show].include?(action_name)) } %></li>
          <li><%= link_to "Cocktails", cocktails_path, class: "p-2", aria: { current: ("page" if controller_name == "cocktails") } %></li>
          <li><%= link_to "Ingredients", ingredients_path, class: "p-2", aria: { current: ("page" if controller_name == "ingredients") } %></li>
          <li><%= link_to "Tools", utensils_path, class: "p-2", aria: { current: ("page" if controller_name == "utensils") } %></li>
          <li><%= link_to "Methods", techniques_path, class: "p-2", aria: { current: ("page" if controller_name == "techniques") } %></li>
        </ul>

        <ul class="order-1 order-md-2">
          <li>
            <button class="fs-lg py-1 px-2 text-muted bg-transparent border-0 rounded-1" onclick="app.toggleTheme(this)">
              <%= icon_svg_tag("sun-moon", class: "d-theme-system-none") %>
              <%= icon_svg_tag("sun-filled", class: "d-theme-manual-none d-theme-light-none") %>
              <%= icon_svg_tag("moon-filled", class: "d-theme-manual-none d-theme-dark-none") %>
            </button>
          </li>

          <li>
            <details>
              <summary aria-haspopup="menu" class="fs-lg bg-transparent border-0">
                <%= icon_svg_tag("language") %>
              </summary>

              <ul dir="rtl" role="menu">
                <li><%= link_to "English", "#", role: "menuitem" %></li>
              </ul>
            </details>
          </li>

          <li>
            <details>
              <summary aria-haspopup="menu" class="bg-transparent border-0">
                <% if authenticated? %>
                  <%= profile_avatar(current_user, size: 30, css_class: "rounded-circle object-fit-cover") %>
                <% else %>
                  <%= icon_svg_tag("user-filled") %>
                <% end %>
              </summary>

              <ul dir="rtl" role="menu">
                <% if authenticated? %>
                  <li><%= link_to "My recipes", user_recipes_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "My collections", user_collections_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "My profile", user_profile_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "My account", user_account_path("my"), role: "menuitem" %></li>
                  <li><%= link_to "Log out", session_path, data: { turbo_method: :delete }, role: "menuitem" %></li>
                <% else %>
                  <li><%= link_to "Log in", new_session_path, role: "menuitem" %></li>
                  <li><%= link_to "Sign up", new_registration_path, role: "menuitem" %></li>
                <% end %>
              </ul>
            </details>
          </li>
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <%= yield %>
    </main>

    <footer class="content-grid mt-3 mt-md-5 border-top py-4">
      <nav class="breakout fs-small">
        <div>
          <%= link_to root_path, class: "brand-link" do %>
            <%= render "shared/wordmark" %>
          <% end %>

          <p class="mt-2 mb-1">Find a drink. Make it yours.</p>

          <small>&copy; <%= Date.current.year %> ShakeStir</small>
        </div>

        <ul class="gap-5" aria-label="Policies and help">
          <li>
            <p class="fs-6 fw-semibold mb-3">Policies</p>

            <ul class="d-flex flex-column gap-3 align-items-start">
              <li><%= modal_link_to "Terms of service", terms_of_service_path, modal: "terms-of-service" %></li>
              <li><%= modal_link_to "Privacy policy", privacy_policy_path, modal: "privacy-policy" %></li>
              <li><%= modal_link_to "Cookies policy", cookies_policy_path, modal: "cookies-policy" %></li>
            </ul>
          </li>

          <li>
            <p class="fs-6 fw-semibold mb-3">Using ShakeStir</p>

            <ul class="d-flex flex-column gap-3 align-items-start">
              <li><%= modal_link_to "Community guidelines", community_guidelines_path, modal: "community-guidelines" %></li>
              <li><%= modal_link_to "Responsible drinking", responsible_drinking_path, modal: "responsible-drinking" %></li>
              <li><%= modal_link_to "Help & contact", help_and_contact_path, modal: "help-and-contact" %></li>
            </ul>
          </li>
        </ul>
      </nav>
    </footer>
  </body>
</html>
