<% content_for :title, "#{@cocktail.display_name} · ShakeStir" %>
<% content_for :body_class, "cocktail-panel-content" if params[:panel] == "1" %>

<article class="cocktail-details cocktail-profile full-width content-grid">
  <%= render "cocktails/hero", cocktail: @cocktail %>
  <%= render "cocktails/background", cocktail: @cocktail %>
  <%= render "cocktails/recipes", recipes: @recipes, filtered: @filtered, other_recipes: @other_recipes %>
</article>
