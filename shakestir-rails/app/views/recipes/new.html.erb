<% content_for :title, "New recipe · ShakeStir" %>
<div class="library-page recipe-editor">
  <%= link_to my_recipes_path, class: "gap-2 mb-4 d-inline-flex align-items-center library-back" do %><%= render "collections/icon", name: "back" %>My recipes<% end %>
  <header class="align-items-start align-items-md-center gap-3 gap-md-4 flex-column flex-md-row d-flex justify-content-between library-heading"><div><h1>New recipe</h1><p class="m-0 library-description">Start with an idea. Refine it at your own pace.</p></div></header>
  <%= render "form", recipe: @recipe %>
</div>
