<% saved_collection_ids = Current.user.collections.joins(:collection_recipes).where(collection_recipes: { recipe_id: recipe.id }).pluck(:id) %>
<div data-controller="collection-picker" data-collection-picker-recipe-id-value="<%= recipe.id %>" data-action="recipe-star:changed@window->collection-picker#syncStar" data-collection-picker-remove-url-value="<%= collection_collection_recipe_path(":collection_id", recipe) %>">
  <button type="button" class="p-0 collection-trigger secondary" aria-label="Manage collections" aria-haspopup="dialog" aria-controls="<%= dom_id(recipe, :collection_picker) %>" data-action="collection-picker#open" data-collection-picker-target="trigger"><span aria-hidden="true"><%= saved_collection_ids.any? ? "✓" : "+" %></span></button>
  <dialog id="<%= dom_id(recipe, :collection_picker) %>" class="m-auto p-4 border-0 collection-dialog" aria-labelledby="<%= dom_id(recipe, :collection_title) %>" data-collection-picker-target="dialog" data-action="click->collection-picker#backdrop">
    <div class="d-flex gap-3 align-items-center justify-content-between collection-dialog-heading"><h2 class="m-0 fs-3" id="<%= dom_id(recipe, :collection_title) %>">Save to collection</h2><button type="button" class="border-0 p-0 collection-close" aria-label="Close" data-action="collection-picker#close">×</button></div>
    <p class="collection-recipe-name"><%= recipe.display_name %></p>
    <p class="collection-picker-hint">Select a collection to save this recipe. Select it again to remove it.</p>
    <%= form_with url: collection_recipes_path, data: { action: "submit->collection-picker#save" } do |form| %>
      <%= form.hidden_field :recipe_id, value: recipe.id, id: dom_id(recipe, :save_collection_recipe) %>
      <div class="gap-2 d-grid overflow-y-auto collection-choices" data-collection-picker-target="choices">
        <% Current.user.collections.order(:created_at).each do |collection| %>
          <button type="submit" name="collection_id" value="<%= collection.id %>" class="gap-2 d-flex align-items-center w-100 m-0 text-start collection-choice" aria-pressed="<%= saved_collection_ids.include?(collection.id) %>"><span><%= collection.name %></span><small class="ms-auto"><%= collection.visibility.capitalize %></small><span class="fw-semibold text-center collection-choice-indicator" aria-hidden="true"><%= saved_collection_ids.include?(collection.id) ? "✓" : "+" %></span></button>
        <% end %>
      </div>
    <% end %>
    <details class="mt-3 pt-3 collection-create" data-collection-picker-target="create">
      <summary class="fw-semibold">+ Create new collection</summary>
      <%= form_with url: collection_recipes_path, class: "mt-3", data: { action: "submit->collection-picker#create" } do |form| %>
        <%= form.hidden_field :recipe_id, value: recipe.id, id: dom_id(recipe, :create_collection_recipe) %>
        <%= label_tag dom_id(recipe, :collection_name), "Name" %>
        <%= text_field_tag "new_collection[name]", nil, id: dom_id(recipe, :collection_name), required: true, placeholder: "e.g. Weekend drinks" %>
        <%= label_tag dom_id(recipe, :collection_visibility), "Visibility" %>
        <%= select_tag "new_collection[visibility]", options_for_select([["Private", "private"], ["Public", "public"]], "private"), id: dom_id(recipe, :collection_visibility) %>
        <%= form.submit "Create and save" %>
      <% end %>
    </details>
    <p role="status" aria-live="polite" data-collection-picker-target="status"></p>
  </dialog>
</div>
