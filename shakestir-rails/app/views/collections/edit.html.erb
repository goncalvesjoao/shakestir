<% content_for :title, "Edit #{@collection.name}" %>

<article class="content-grid mt-3 mt-md-4">
  <turbo-frame id="edit-collection-<%= @collection.id %>-frame">
    <header>
      <hgroup>
        <h1>Edit collection</h1>
        <p>Give it a name. Choose who can see it.</p>
      </hgroup>
    </header>

    <%= form_with model: @collection, method: :patch, id: "edit-collection-form", class: "card" do |form| %>
      <% if @collection.errors.any? %>
        <div class="p-3 mb-4 rounded library-errors" role="alert">
          <strong>Check your collection details</strong>
          <ul class="mb-0 ps-4">
            <% @collection.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <fieldset>
        <%= form.label :name %>
        <%= form.text_field :name, required: true, placeholder: "e.g. Friday night favorites", aria: { describedby: "input-name-help" } %>
        <small id="input-name-help">A mood, an occasion, or simply your favorites.</small>
      </fieldset>

      <% if @collection.system_key == "favorites" %>
        <p>Your starred recipes stay in this private Favorites collection. You can rename it.</p>
      <% else %>
        <fieldset>
          <legend class="fw-semibold mb-2">Who can see this collection?</legend>

          <label class="hstack gap-2 mb-3">
            <%= form.radio_button :visibility, "private", class: "m-0 flex-shrink-0" %>

            <span class="vstack">
              <span><%= icon_svg_tag("lock-filled") %><strong>Private</strong></span>
              <small class="text-muted">Only you. Keep your discoveries to yourself.</small>
            </span>
          </label>

          <label class="d-flex gap-2 align-items-center">
            <%= form.radio_button :visibility, "public", class: "m-0 flex-shrink-0" %>
            
            <span class="vstack">
              <span><%= icon_svg_tag("world") %><strong>Public</strong></span>
              <small class="text-muted">Anyone with the link can view this collection.</small>
            </span>
          </label>
        </fieldset>
      <% end %>
    <% end %>
    

    <footer>
      <nav>
        <ul></ul>
        <ul>
          <li><%= button_tag "Update", form: "edit-collection-form", data: { turbo_submits_with: "Updating..." } %></li>
          <li><%= button_tag "Cancel", onclick: "app.goBack(this)", class: "secondary" %></li>
        </ul>
      </nav>
    </footer>
  </turbo-frame>
</article>
