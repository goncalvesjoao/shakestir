<article id="<%= dom_id cocktail %>">
  <%= sidebar_link_to(cocktail, sidebar: dom_id(cocktail), class: "d-flex flex-column overflow-hidden", tabindex: "-1") do %>
    <%= image_tag(
      cocktail_attachment_path(cocktail, size: :card),
      alt: "Photo of #{cocktail.display_name}",
      loading: "lazy",
      class: "w-100"
    ) %>

    <h2 class="fs-3 text-center m-0"><%= cocktail.display_name %></h2>
  <% end %>
</article>
